# DOCKER COMPOSE
COMPOSE_PROJECT_NAME=streaming_system

# SYSTEM IDENTIFICATION
STREAM_INSTANCE_ID=stream1

# KAFKA
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=commodity_prices
KAFKA_CONSUMER_GROUP=spark_stream_raw_prices
KAFKA_LAG_POLL_SEC=60

# TWELVE DATA API
TD_API_KEY=your_api_key_here
TD_BASE=https://api.twelvedata.com
SOURCE=twelvedata_rest
INTERVAL_SEC=360

# PRODUCER HTTP AND BACKOFF | Retry pacing after failed API calls
HTTP_TIMEOUT_SEC=10
BACKOFF_MIN_SEC=15
# Defaults to INTERVAL_SEC * 10 (3600s) when unset
BACKOFF_MAX_SEC=3600

# POSTGRES (PRIMARY DATABASE)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=commodities
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# GRAFANA DATABASE ACCESS (READ-ONLY USER) | Used by Grafana datasource to read analytics tables
GRAFANA_DB_USER=grafana_read
GRAFANA_DB_PASSWORD=change_me

# SPARK STREAMING DATABASE ACCESS | Used by spark-stream container to write raw events
SPARK_DB_USER=spark_writer
SPARK_DB_PASSWORD=change_me

# SPARK JDBC TIMEOUTS (seconds) | PostgreSQL driver connect/socket timeouts
JDBC_CONNECT_TIMEOUT=10
JDBC_SOCKET_TIMEOUT=30

# SPARK STREAMING | Kafka read behaviour and checkpoint location.
# Clearing the checkpoint directory replays the topic from `earliest`.
KAFKA_STARTING_OFFSETS=earliest
KAFKA_FAIL_ON_DATA_LOSS=false
KAFKA_MAX_OFFSETS_PER_TRIGGER=5000
# Changing this path starts the stream from a fresh checkpoint, i.e. replays
# the topic from KAFKA_STARTING_OFFSETS. Keep it inside the spark_checkpoints volume.
SPARK_CHECKPOINT_DIR=/home/spark/checkpoints/raw_prices
SPARK_LOG_LEVEL=WARN

# SPARK TARGET TABLES | Change only together with ops/sql/init.sql and grants.sql
PG_TARGET_TABLE=public.raw_prices
PG_STAGING_TABLE=ingest.raw_prices_staging
PG_DLQ_TABLE=monitoring.dead_letter_events
PG_DLQ_STAGING_TABLE=ingest.dlq_staging

# DBT DATABASE ACCESS | Used by dbt container to build analytics models
DBT_DB_USER=dbt_runner
DBT_DB_PASSWORD=change_me

# DBT SCHEDULER | Loop intervals and the label written to monitoring.dbt_test_runs
DBT_RUN_INTERVAL_SEC=360
DBT_TEST_INTERVAL_SEC=1800
RETENTION_INTERVAL_SEC=86400
DQ_ENVIRONMENT=dev

# PRODUCER DATABASE ACCESS | Used by API producer to log API metrics
PRODUCER_DB_USER=producer_writer
PRODUCER_DB_PASSWORD=change_me

# BACKUP DATABASE ACCESS | Used by backup service (pg_dump)
BACKUP_DB_USER=backup_user
BACKUP_DB_PASSWORD=change_me

# ALERT RECEIVER DATABASE ACCESS | Used by alert-receiver to log Grafana alerts
ALERT_DB_USER=alert_writer
ALERT_DB_PASSWORD=change_me

# KAFKA LAG MONITOR DATABASE ACCESS | Used by kafka-lag to log consumer lag
LAG_DB_USER=lag_writer
LAG_DB_PASSWORD=change_me

# GRAFANA ADMIN LOGIN
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me

# PGADMIN (DEV ONLY)
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=change_me

# ALERT RECEIVER WEBHOOK AUTH | Disabled for local dev (set ALERT_WEBHOOK_TOKEN in production)
# The token is sent by Grafana as the X-Webhook-Token header (see
# grafana/provisioning/alerting/contactpoints.yaml) and checked by alert-receiver.
ALERT_WEBHOOK_AUTH_DISABLED=true
ALERT_WEBHOOK_TOKEN=
